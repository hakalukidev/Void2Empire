APP_ENV=development
PORT=8080
DATABASE_URL=postgres://void2empire:void2empire_dev@localhost:5432/void2empire?sslmode=disable

# Required. cmd/api refuses to start without a value of at least 32 bytes, and
# there is no default to fall back on. Generate one; do not paste a value from
# anywhere shared.
#   openssl rand -base64 48
JWT_SECRET=

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Rule #42: real money stays off outside an approved environment. Anything other
# than true/false here stops the boot rather than being read as false.
FEATURE_REAL_TRADING_ENABLED=false

# Optional. Extra peer addresses whose X-Forwarded-For may be believed, beyond
# loopback and the private ranges (already trusted, which covers Caddy on the
# compose network). Comma-separated CIDRs; a bare IP stops the boot.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
