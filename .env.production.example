# Copy to .env on the VPS and fill in. Never commit the real .env.
#
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -base64 32   # POSTGRES_PASSWORD
#   openssl rand -base64 32   # REDIS_PASSWORD
#
# An empty JWT_SECRET is not a bootable configuration: the API exits instead of
# starting, and compose marks the backend unhealthy, so `docker compose ps` shows
# it rather than a silently unsigned session key.

APP_DOMAIN=void2empire.com
ACME_EMAIL=support@void2empire.com

POSTGRES_USER=void2empire
POSTGRES_PASSWORD=
POSTGRES_DB=void2empire

JWT_SECRET=
REDIS_PASSWORD=

# Rule #42. Real trading stays off until the client approves the go-live gate
# (REQ-094); set it to true only in that environment, and only deliberately.
FEATURE_REAL_TRADING_ENABLED=false
